# --- Backend (api/) ---
DATABASE_URL=postgresql://user:password@localhost:5432/should_i_go
GEMINI_API_KEY= # paid Gemini key (project with billing); used only in production (see APP_ENV)
APP_ENV= # set to production on the Railway fast-api service only; anything else uses the free-tier key
# Optional: use another OpenAI-compatible provider instead (e.g. OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY= # paid key for that provider, never the free-tier eval key
# LLM_MODEL=google/gemini-3.5-flash-lite
O_NET_API_KEY=your-onet-api-key
GEMINI_FREE_TIER_API_KEY= # free-tier key from https://aistudio.google.com/apikey (project with no billing); used for local development and evals, made-up data only; never set it in production
COLLEGE_SCORECARD_API_KEY=your-api-key-from-api.data.gov

# --- Frontend (Next.js) ---
DATABASE_URL=postgresql://user:password@localhost:5432/should_i_go
COLLEGE_SCORECARD_API_KEY=your-api-key-from-api.data.gov # school search fallback and program data
AGENT_API_URL=http://localhost:8000
BLS_API_KEY=your-bls-api-key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
RESEND_API_KEY=re_... # https://resend.com/api-keys
