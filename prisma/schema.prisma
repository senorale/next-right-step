// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OccupationCategory {
  id                       String                  @id @default(uuid())
  name                     String                  @unique
  occupation_code          String                  @unique
  occupation_sub_categories OccupationSubCategory[]
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
}

model OccupationSubCategory {
  id                  String             @id @default(uuid())
  name                String
  occupation_code     String
  annual_salary       Float
  category           OccupationCategory @relation(fields: [category_id], references: [id])
  category_id        String
  typical_years_of_school Float?
  major_mappings     MajorOccupation[]
  cip_mappings       CipOccupation[]
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  @@unique([category_id, occupation_code])
  @@index([occupation_code])
}

model Major {
  id          String            @id @default(uuid())
  name        String            @unique
  occupations MajorOccupation[]
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
}

model MajorOccupation {
  id            String               @id @default(uuid())
  major         Major                @relation(fields: [major_id], references: [id])
  major_id      String
  occupation    OccupationSubCategory @relation(fields: [occupation_id], references: [id])
  occupation_id String
  relevance     Float                // 0-1, how likely this major leads to this occupation

  @@unique([major_id, occupation_id])
  @@index([major_id])
  @@index([occupation_id])
}

model CipCode {
  id          String          @id @default(uuid())
  code        String          @unique // 4-digit CIP, no dot, e.g. "1107"
  title       String
  occupations CipOccupation[]
  debt        ProgramDebt[]
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
}

model CipOccupation {
  id            String               @id @default(uuid())
  cip           CipCode              @relation(fields: [cip_id], references: [id])
  cip_id        String
  occupation    OccupationSubCategory @relation(fields: [occupation_id], references: [id])
  occupation_id String

  @@unique([cip_id, occupation_id])
  @@index([cip_id])
  @@index([occupation_id])
}

// Median student debt at completion, aggregated across schools from the
// College Scorecard field-of-study data. One row per CIP + credential level
// + school type combination.
model ProgramDebt {
  id               String   @id @default(uuid())
  cip              CipCode  @relation(fields: [cip_id], references: [id])
  cip_id           String
  credential_level Int      // 1=Undergrad Cert, 2=Associate, 3=Bachelor, 5=Master, 6=Doctoral, 7=First Professional, 8=Grad/Prof Cert
  credential_label String   // e.g. "Bachelor's Degree"
  school_type      String   // public | private_nonprofit | all
  median_debt      Int
  mean_debt        Int?
  sample_size      Int      // number of schools reporting
  source           String   @default("College Scorecard: Most-Recent-Cohorts-Field-of-Study")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([cip_id, credential_level, school_type])
  @@index([cip_id])
}

// Median cost of attendance figures per school cohort, sourced from the
// U.S. Dept. of Education College Scorecard. Values are ANNUAL; the app
// multiplies by years in school to get a total. Public out-of-state has no
// net price because the Scorecard only reports net price for in-state students.
model TuitionMedian {
  id                       String   @id @default(uuid())
  cohort                   String   @unique // public_in_state | public_out_of_state | private_nonprofit | all
  label                    String            // human label e.g. "Public (in-state)"
  sticker_annual           Int?              // median tuition + fees, before aid
  net_price_annual         Int?              // median cost of attendance minus grant aid
  cost_of_attendance_annual Int?             // median full cost incl. living, before aid
  sample_size              Int               // number of schools in the median
  source                   String   @default("College Scorecard: Most-Recent-Cohorts-Institution")
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}
